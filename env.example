DATABASE_URL=sqlite:///./test.db
SECRET_KEY=dev-secret-key-change-later
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 문서 · 청킹 ──
RAG_SOURCE=db
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# ── 검색 ──
RAG_TOP_K=4
RAG_TOP_K_REGION=2      # 선택한 지역 전용 문서
RAG_TOP_K_COMMON=1      # 전국 공통 가이드
RAG_TOP_K_LAW=2         # 법령
RAG_MIN_SCORE=0.36      # 유사도 임계값 (백엔드 바꾸면 재측정 필수)
RAG_MIN_SCORE_LOCAL=0.05  # hash 백엔드 전용

# ── 임베딩 ──
# hash=검증용 / local=sentence-transformers(무료) / gemini / openai
EMBEDDING_BACKEND=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536
LOCAL_EMBEDDING_DIMENSION=384
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_EMBEDDING_BATCH=25
GEMINI_BATCH_DELAY=5

# ── 답변 생성 ──
LLM_BACKEND=openai
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash

# ── API 키 ──
OPENAI_API_KEY=여기에_실제_키
GEMINI_API_KEY=