DATABASE_URL=
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── RAG 설정 (RAG 파트 추가) ──
# db = MySQL documents 테이블 / files = data/docs 폴더 (DB 없이 테스트)
RAG_SOURCE=db
CHUNK_SIZE=700
CHUNK_OVERLAP=100
RAG_TOP_K=4
# local = API 키 불필요(개발용) / gemini = 실서비스
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_DIMENSION=384
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
